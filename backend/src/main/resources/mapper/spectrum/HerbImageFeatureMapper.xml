<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bdis.modules.spectrum.mapper.HerbImageFeatureMapper">
    <resultMap id="FeatureResultMap" type="com.bdis.modules.spectrum.entity.HerbImageFeatureEntity">
        <id column="id" property="id"/>
        <result column="image_id" property="imageId"/>
        <result column="species_id" property="speciesId"/>
        <result column="feature_code" property="featureCode"/>
        <result column="feature_vector" property="featureVector"/>
        <result column="feature_dimension" property="featureDimension"/>
        <result column="feature_model" property="featureModel"/>
        <result column="feature_version" property="featureVersion"/>
        <result column="extract_status" property="extractStatus"/>
        <result column="extract_time" property="extractTime"/>
        <result column="error_message" property="errorMessage"/>
        <result column="create_time" property="createTime"/>
        <result column="update_time" property="updateTime"/>
        <result column="deleted" property="deleted"/>
    </resultMap>

    <resultMap id="FeatureVOResultMap" type="com.bdis.modules.spectrum.vo.FeatureExtractResultVO">
        <result column="target_type" property="targetType"/>
        <result column="target_id" property="targetId"/>
        <result column="image_id" property="imageId"/>
        <result column="species_id" property="speciesId"/>
        <result column="feature_code" property="featureCode"/>
        <result column="feature_vector" property="featureVector"/>
        <result column="feature_dimension" property="featureDimension"/>
        <result column="feature_model" property="featureModel"/>
        <result column="feature_version" property="featureVersion"/>
        <result column="extract_status" property="extractStatus"/>
        <result column="extract_time" property="extractTime"/>
        <result column="error_message" property="errorMessage"/>
    </resultMap>

    <insert id="insertFeature" parameterType="com.bdis.modules.spectrum.entity.HerbImageFeatureEntity"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO herb_image_feature (
            image_id,
            species_id,
            feature_code,
            feature_vector,
            feature_dimension,
            feature_model,
            feature_version,
            extract_status,
            extract_time,
            error_message,
            create_time,
            update_time,
            deleted
        ) VALUES (
            #{imageId},
            #{speciesId},
            #{featureCode},
            #{featureVector},
            #{featureDimension},
            #{featureModel},
            #{featureVersion},
            #{extractStatus},
            #{extractTime},
            #{errorMessage},
            #{createTime},
            #{updateTime},
            #{deleted}
        )
    </insert>

    <update id="deleteActiveByImageIdAndModel">
        UPDATE herb_image_feature
        SET deleted = 1,
            update_time = NOW()
        WHERE image_id = #{imageId}
          AND feature_model = #{featureModel}
          AND feature_version = #{featureVersion}
          AND deleted = 0
    </update>

    <select id="existsSuccessByImageIdAndModel" resultType="int">
        SELECT COUNT(1)
        FROM herb_image_feature
        WHERE image_id = #{imageId}
          AND feature_model = #{featureModel}
          AND feature_version = #{featureVersion}
          AND extract_status = 'success'
          AND deleted = 0
        LIMIT 1
    </select>

    <select id="selectLatestSuccessByImageId" resultMap="FeatureVOResultMap">
        SELECT
        'image' AS target_type,
        image_id AS target_id,
        image_id,
        species_id,
        feature_code,
        feature_vector,
        feature_dimension,
        feature_model,
        feature_version,
        extract_status,
        extract_time,
        error_message
        FROM herb_image_feature
        WHERE image_id = #{imageId}
          AND extract_status = 'success'
          AND deleted = 0
        ORDER BY extract_time DESC, create_time DESC
        LIMIT 1
    </select>
</mapper>
