<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bdis.modules.spectrum.mapper.HerbAtlasTagMapper">
    <resultMap id="TagResultMap" type="com.bdis.modules.spectrum.entity.SpectrumTagEntity">
        <id column="id" property="id"/>
        <result column="atlas_id" property="atlasId"/>
        <result column="tag_name" property="tagName"/>
        <result column="tag_type" property="tagType"/>
        <result column="tag_source" property="tagSource"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="status" property="status"/>
        <result column="created_at" property="createdAt"/>
        <result column="updated_at" property="updatedAt"/>
        <result column="is_deleted" property="isDeleted"/>
    </resultMap>

    <insert id="insertTags">
        INSERT INTO herb_atlas_tag (
            atlas_id,
            tag_name,
            tag_type,
            status,
            created_at,
            updated_at,
            is_deleted
        ) VALUES
        <foreach collection="tags" item="tag" separator=",">
            (
                #{tag.atlasId},
                #{tag.tagName},
                #{tag.tagType},
                #{tag.status},
                #{tag.createdAt},
                #{tag.updatedAt},
                #{tag.isDeleted}
            )
        </foreach>
    </insert>

    <update id="logicalDeleteByAtlasId" parameterType="com.bdis.modules.spectrum.entity.SpectrumTagEntity">
        UPDATE herb_atlas_tag
        SET is_deleted = 1,
            updated_at = #{updatedAt}
        WHERE atlas_id = #{atlasId}
          AND is_deleted = 0
    </update>

    <select id="selectByAtlasId" resultMap="TagResultMap">
        SELECT
            id,
            atlas_id,
            tag_name,
            tag_type,
            tag_source,
            sort_order,
            status,
            created_at,
            updated_at,
            is_deleted
        FROM herb_atlas_tag
        WHERE atlas_id = #{atlasId}
          AND is_deleted = 0
        ORDER BY created_at ASC, id ASC
    </select>
</mapper>
