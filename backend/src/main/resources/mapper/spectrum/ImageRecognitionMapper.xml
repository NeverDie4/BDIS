<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper
        PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bdis.modules.spectrum.mapper.ImageRecognitionMapper">
    <resultMap id="BaseResultMap" type="com.bdis.modules.spectrum.entity.ImageRecognitionEntity">
        <id column="id" property="id"/>
        <result column="image_id" property="imageId"/>
        <result column="model_id" property="modelId"/>
        <result column="model_code" property="modelCode"/>
        <result column="model_version" property="modelVersion"/>
        <result column="rank_no" property="rankNo"/>
        <result column="species_id" property="speciesId"/>
        <result column="recognized_herb_name" property="recognizedHerbName"/>
        <result column="confidence" property="confidence"/>
        <result column="image_type" property="imageType"/>
        <result column="growth_stage" property="growthStage"/>
        <result column="medicinal_part" property="medicinalPart"/>
        <result column="health_status" property="healthStatus"/>
        <result column="form_type" property="formType"/>
        <result column="color_feature" property="colorFeature"/>
        <result column="texture_feature" property="textureFeature"/>
        <result column="shape_feature" property="shapeFeature"/>
        <result column="reason" property="reason"/>
        <result column="suggestion" property="suggestion"/>
        <result column="raw_response" property="rawResponse"/>
        <result column="is_uncertain" property="isUncertain"/>
        <result column="created_at" property="createdAt"/>
    </resultMap>

    <resultMap id="RecognitionVOResultMap" type="com.bdis.modules.spectrum.vo.HerbRecognitionVO">
        <id column="id" property="id"/>
        <result column="image_id" property="imageId"/>
        <result column="image_code" property="imageCode"/>
        <result column="image_url" property="imageUrl"/>
        <result column="model_version_id" property="modelVersionId"/>
        <result column="predicted_species_id" property="predictedSpeciesId"/>
        <result column="predicted_species_name" property="predictedSpeciesName"/>
        <result column="predicted_name" property="predictedName"/>
        <result column="confidence" property="confidence"/>
        <result column="recognition_status" property="recognitionStatus"/>
        <result column="need_review" property="needReview"/>
        <result column="recognition_time" property="recognitionTime"/>
        <result column="raw_result" property="rawResult"/>
    </resultMap>

    <sql id="RecognitionVOColumns">
        r.id,
        r.image_id,
        i.image_no AS image_code,
        i.image_url,
        r.model_id AS model_version_id,
        r.species_id AS predicted_species_id,
        s.herb_name AS predicted_species_name,
        r.recognized_herb_name AS predicted_name,
        r.confidence,
        CASE WHEN r.is_uncertain = 1 THEN 'review_required' ELSE 'success' END
            AS recognition_status,
        r.is_uncertain AS need_review,
        r.created_at AS recognition_time,
        r.raw_response AS raw_result
    </sql>

    <insert id="insertRecognition"
            parameterType="com.bdis.modules.spectrum.entity.ImageRecognitionEntity"
            useGeneratedKeys="true" keyProperty="id">
        INSERT INTO herb_image_recognition (
            image_id,
            model_id,
            model_code,
            model_version,
            rank_no,
            species_id,
            recognized_herb_name,
            confidence,
            image_type,
            growth_stage,
            medicinal_part,
            health_status,
            form_type,
            color_feature,
            texture_feature,
            shape_feature,
            reason,
            suggestion,
            raw_response,
            is_uncertain,
            created_at
        ) VALUES (
            #{imageId},
            #{modelId},
            #{modelCode},
            #{modelVersion},
            #{rankNo},
            #{speciesId},
            #{recognizedHerbName},
            #{confidence},
            #{imageType},
            #{growthStage},
            #{medicinalPart},
            #{healthStatus},
            #{formType},
            #{colorFeature},
            #{textureFeature},
            #{shapeFeature},
            #{reason},
            #{suggestion},
            #{rawResponse},
            #{isUncertain},
            #{createdAt}
        )
    </insert>

    <sql id="RecognitionWhere">
        <where>
            <if test="query.imageId != null">
                r.image_id = #{query.imageId}
            </if>
            <if test="query.predictedSpeciesId != null">
                AND r.species_id = #{query.predictedSpeciesId}
            </if>
            <if test="query.predictedName != null and query.predictedName != ''">
                AND r.recognized_herb_name LIKE CONCAT('%', #{query.predictedName}, '%')
            </if>
            <if test="query.recognitionStatus != null and query.recognitionStatus != ''">
                AND CASE WHEN r.is_uncertain = 1 THEN 'review_required' ELSE 'success' END
                    = #{query.recognitionStatus}
            </if>
            <if test="query.startTime != null">
                AND r.created_at &gt;= #{query.startTime}
            </if>
            <if test="query.endTime != null">
                AND r.created_at &lt;= #{query.endTime}
            </if>
        </where>
    </sql>

    <select id="selectLatestByImageId" resultMap="RecognitionVOResultMap">
        SELECT
        <include refid="RecognitionVOColumns"/>
        FROM herb_image_recognition r
        LEFT JOIN herb_image i ON i.id = r.image_id AND i.is_deleted = 0
        LEFT JOIN herb_species s ON s.id = r.species_id AND s.is_deleted = 0
        WHERE r.image_id = #{imageId}
        ORDER BY r.created_at DESC, r.rank_no ASC
        LIMIT 1
    </select>

    <select id="selectVoById" resultMap="RecognitionVOResultMap">
        SELECT
        <include refid="RecognitionVOColumns"/>
        FROM herb_image_recognition r
        LEFT JOIN herb_image i ON i.id = r.image_id AND i.is_deleted = 0
        LEFT JOIN herb_species s ON s.id = r.species_id AND s.is_deleted = 0
        WHERE r.id = #{id}
        LIMIT 1
    </select>

    <select id="selectByImageId" resultMap="RecognitionVOResultMap">
        SELECT
        <include refid="RecognitionVOColumns"/>
        FROM herb_image_recognition r
        LEFT JOIN herb_image i ON i.id = r.image_id AND i.is_deleted = 0
        LEFT JOIN herb_species s ON s.id = r.species_id AND s.is_deleted = 0
        WHERE r.image_id = #{imageId}
        ORDER BY r.created_at DESC, r.rank_no ASC
    </select>

    <select id="countPage" resultType="java.lang.Long">
        SELECT COUNT(1)
        FROM herb_image_recognition r
        <include refid="RecognitionWhere"/>
    </select>

    <select id="selectPage" resultMap="RecognitionVOResultMap">
        SELECT
        <include refid="RecognitionVOColumns"/>
        FROM herb_image_recognition r
        LEFT JOIN herb_image i ON i.id = r.image_id AND i.is_deleted = 0
        LEFT JOIN herb_species s ON s.id = r.species_id AND s.is_deleted = 0
        <include refid="RecognitionWhere"/>
        ORDER BY r.created_at DESC, r.rank_no ASC
        LIMIT #{offset}, #{pageSize}
    </select>
</mapper>
