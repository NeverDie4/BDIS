FILE_ATLAS_IMPORT_PATH=import/herb_atlas
HERB_RECOGNITION_SERVICE_URL=http://localhost:8001/recognize
HERB_FEATURE_SERVICE_URL=http://localhost:8002/feature
HERB_FEATURE_EXTRACTION_SERVICE_URL=http://localhost:8002/extract-feature
HERB_RECOGNITION_ENABLED=false
HERB_FEATURE_ENABLED=true
HERB_FEATURE_TIMEOUT_SECONDS=30
HERB_FEATURE_MODEL_VERSION=resnet50-imagenet-v1
HERB_FEATURE_RECOVERY_ENABLED=true
HERB_FEATURE_RECOVERY_INITIAL_DELAY_MS=5000
HERB_FEATURE_RECOVERY_INTERVAL_MS=60000
ARK_API_KEY=
HERB_ASSISTANT_ENABLED=true
HERB_ASSISTANT_MOCK_ENABLED=false
HERB_ASSISTANT_MODEL=your-model-id
