HERB_ASSISTANT_RAG_EMBEDDING_API_KEY=your-api-key
HERB_ASSISTANT_RAG_VECTOR_STORE_PATH=data/vector-store/herb-knowledge.json
HERB_ASSISTANT_RAG_CHUNK_SIZE=800
HERB_ASSISTANT_RAG_CHUNK_OVERLAP=100
