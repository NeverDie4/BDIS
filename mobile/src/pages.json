{
  "easycom": {
    "autoscan": true,
    "custom": {
      "^AssistantFloat$": "@/components/AssistantFloat.vue"
    }
  },
  "pages": [
    {
      "path": "pages/login/index",
      "style": {
        "navigationBarTitleText": "登录"
      }
    },
    {
      "path": "pages/index/index",
      "style": {
        "navigationBarTitleText": "首页"
      }
    },
    {
      "path": "pages/task/list",
      "style": {
        "navigationBarTitleText": "我的采集任务",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/task/detail",
      "style": {
        "navigationBarTitleText": "任务详情",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/batch/list",
      "style": {
        "navigationBarTitleText": "批次列表",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/batch/create",
      "style": {
        "navigationBarTitleText": "新建批次"
      }
    },
    {
      "path": "pages/batch/detail",
      "style": {
        "navigationBarTitleText": "批次详情",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/growth/form",
      "style": {
        "navigationBarTitleText": "生长记录"
      }
    },
    {
      "path": "pages/image/upload",
      "style": {
        "navigationBarTitleText": "图片上传"
      }
    },
    {
      "path": "pages/image/result",
      "style": {
        "navigationBarTitleText": "识别结果",
        "enablePullDownRefresh": true
      }
    },
    {
      "path": "pages/mine/index",
      "style": {
        "navigationBarTitleText": "我的"
      }
    }
  ],
  "globalStyle": {
    "navigationBarTextStyle": "black",
    "navigationBarTitleText": "生物医药数字信息系统",
    "navigationBarBackgroundColor": "#fffaf2",
    "backgroundColor": "#f7f1e6"
  },
  "tabBar": {
    "custom": false,
    "color": "#7c6f5c",
    "selectedColor": "#0f5132",
    "backgroundColor": "#fffaf2",
    "borderStyle": "white",
    "list": [
      {
        "pagePath": "pages/index/index",
        "text": "首页"
      },
      {
        "pagePath": "pages/task/list",
        "text": "任务"
      },
      {
        "pagePath": "pages/mine/index",
        "text": "我的"
      }
    ]
  }
}
