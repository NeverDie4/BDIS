{
  "name": "生物医药数字信息系统",
  "appid": "__UNI__BDIS",
  "description": "中药材采集与图谱识别手机端",
  "versionName": "0.1.0",
  "versionCode": "100",
  "transformPx": false,
  "h5": {
    "router": {
      "mode": "hash"
    },
    "title": "BDIS 手机端"
  },
  "app-plus": {
    "usingComponents": true,
    "distribute": {
      "android": {
        "permissions": [
          "<uses-permission android:name=\"android.permission.ACCESS_COARSE_LOCATION\"/>",
          "<uses-permission android:name=\"android.permission.ACCESS_FINE_LOCATION\"/>"
        ]
      },
      "ios": {
        "privacyDescription": {
          "NSLocationWhenInUseUsageDescription": "用于记录中药材生长观测阶段的采集位置"
        }
      }
    }
  },
  "mp-weixin": {
    "permission": {
      "scope.userLocation": {
        "desc": "用于记录中药材生长观测阶段的采集位置"
      }
    },
    "requiredPrivateInfos": [
      "getLocation"
    ]
  }
}
