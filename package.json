{
  "name": "bdis",
  "private": true,
  "packageManager": "pnpm@11.3.0",
  "scripts": {
    "setup": "node scripts/setup-env.mjs",
    "check": "node scripts/check-env.mjs",
    "validate": "node scripts/validate.mjs",
    "clean": "node scripts/clean.mjs",
    "dev": "pnpm run dev:web",
    "dev:web": "pnpm --dir frontend dev",
    "dev:mobile": "pnpm --dir mobile dev:h5",
    "dev:api": "node scripts/run-maven.mjs -f backend/pom.xml spring-boot:run",
    "dev:infra": "docker compose up mysql redis",
    "db:info": "node scripts/run-flyway.mjs info",
    "db:migrate": "node scripts/run-flyway.mjs migrate",
    "db:validate": "node scripts/run-flyway.mjs validate",
    "db:repair": "node scripts/run-flyway.mjs repair",
    "db:clean:local": "node scripts/run-flyway.mjs clean --local",
    "build": "pnpm run build:web",
    "build:web": "pnpm --dir frontend build",
    "build:mobile:h5": "pnpm --dir mobile build:h5",
    "lint": "pnpm run lint:web",
    "lint:web": "pnpm --dir frontend lint",
    "format": "pnpm run format:web",
    "format:web": "pnpm --dir frontend format",
    "test": "node scripts/run-maven.mjs -f backend/pom.xml test",
    "test:api": "node scripts/run-maven.mjs -f backend/pom.xml test",
    "test:growth:audit": "node scripts/test-growth-audit-chain.mjs",
    "test:growth:trace": "node scripts/test-growth-trace-qrcode.mjs",
    "demo:soap": "node scripts/demo-soap.mjs",
    "compose:config": "docker compose config --quiet",
    "compose:up": "docker compose up --build",
    "compose:down": "docker compose down"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^15.5.2",
    "prettier": "^3.5.3"
  },
  "lint-staged": {
    "frontend/**/*.{ts,tsx,js,jsx,json,css,md}": [
      "pnpm --dir frontend lint",
      "pnpm --dir frontend format"
    ],
    "backend/**/*.{yml,yaml,md}": [
      "prettier --write"
    ]
  }
}
